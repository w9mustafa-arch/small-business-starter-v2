---
import { siteData } from '../data/siteData';

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const whatsappNumber = siteData.phoneForTel.replace(/\D/g, '');
const whatsappMessage = encodeURIComponent('Bonjour, je souhaite commander une livraison à Marrakech.');

const {
  title = 'Besoin d’une livraison à Marrakech ?',
  description = 'Envoyez votre demande sur WhatsApp. Réponse rapide, 24h/24 et 7j/7.',
  buttonText = 'Commander sur WhatsApp',
  buttonHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`,
} = Astro.props;
---

<section class="relative overflow-hidden bg-primary py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-site px-4 text-center sm:px-6">
    <h2 class="font-heading text-h2 font-bold uppercase text-primary-fg">
      {title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-primary-fg leading-relaxed">
      {description}
    </p>

    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={buttonHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-lg ring-2 ring-white/70 transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.52 3.48A11.86 11.86 0 0012.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.96L0 24l6.3-1.65a11.9 11.9 0 005.76 1.47h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.16-3.45-8.44zM12.07 21.8h-.01a9.9 9.9 0 01-5.05-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.88 9.88 0 01-1.51-5.27c0-5.46 4.45-9.9 9.92-9.9 2.64 0 5.12 1.03 6.99 2.9a9.84 9.84 0 012.9 7c0 5.46-4.45 9.9-9.9 9.9zm5.43-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z"/>
        </svg>
        {buttonText}
      </a>
      <a
        href={`tel:${siteData.phoneForTel}`}
        class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-md border-2 border-primary-fg/40 px-8 py-3 text-base font-bold text-primary-fg transition-colors hover:border-primary-fg hover:bg-primary-fg/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"
      >
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.5a1 1 0 01-.5 1.2l-2.26 1.13a11 11 0 005.52 5.52l1.13-2.26a1 1 0 011.2-.5l4.5 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" />
        </svg>
        Appeler le{" "}{siteData.phoneFormatted}
      </a>
    </div>
  </div>
</section>
