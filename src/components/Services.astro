---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteData } from '../data/siteData';

interface ServiceItem {
  key?: string;
  title: string;
  description: string;
  href?: string;
  buttonText?: string;
}

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  services?: ServiceItem[];
}

const {
  topper = 'Nos services',
  heading = 'Nos services de livraison',
  description = 'Repas, courses, colis et bien plus, livrés à Marrakech.',
  services = siteData.services,
} = Astro.props;

// Photos des cartes : déposez une image dans src/assets/images/services/
// dont le nom correspond à la clé du service (ex. pharmacie.jpg, pressing.jpg).
const serviceImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/services/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const imageByKey: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(serviceImages)) {
  const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  imageByKey[name] = mod.default;
}

// Icônes de secours pour les services sans photo.
const icons: Record<string, string> = {
  pharmacie: 'M9 3h6v6h6v6h-6v6H9v-6H3V9h6z',
  pressing:
    'M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z',
};
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <span class="text-topper font-bold uppercase tracking-widest text-primary">
        {topper}
      </span>

      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
        {heading}
      </h2>

      <p class="mt-3 text-text-muted leading-relaxed">
        {description}
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {services.map((service) => {
        const image = service.key ? imageByKey[service.key] : undefined;
        const icon = service.key ? icons[service.key] : undefined;
        return (
          <li class="h-full">
            <div
              class:list={[
                'group relative isolate flex h-full min-h-[22rem] flex-col justify-end overflow-hidden rounded-lg p-6 shadow-sm transition-shadow duration-200 hover:shadow-lg',
                image ? 'bg-dark' : 'bg-linear-to-br from-primary to-dark',
              ]}
            >
              {image && (
                <>
                  <Image
                    src={image}
                    alt=""
                    aria-hidden="true"
                    widths={[480, 720, 960]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    loading="lazy"
                    class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                  <div
                    class="absolute inset-0 -z-10 bg-linear-to-t from-dark/90 via-dark/55 to-dark/10"
                    aria-hidden="true"
                  />
                </>
              )}

              {!image && icon && (
                <div
                  class="absolute left-6 top-6 flex size-14 items-center justify-center rounded-full bg-white/15 text-white"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                  >
                    <path d={icon} />
                  </svg>
                </div>
              )}

              <h3 class="font-heading text-h3 font-semibold text-white">
                {service.title}
              </h3>

              <p class="mt-2 text-sm leading-relaxed text-white/85">
                {service.description}
              </p>

              <a
                href={service.href || 'https://wa.me/212674007161'}
                target="_blank"
                rel="noopener noreferrer"
                class="group/btn mt-5 inline-flex w-fit items-center gap-1 rounded-md bg-white px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-accent hover:text-accent-fg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
              >
                {service.buttonText || 'Commander maintenant'}
                <span
                  class="transition-transform group-hover/btn:translate-x-0.5"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </a>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
