---
import { siteData } from '../data/siteData';

interface ServiceItem {
  title: string;
  description: string;
  href?: string;
  buttonText?: string;
}

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  services?: ServiceItem[];
}

const {
  topper = 'Nos services',
  heading = 'Nos services de livraison',
  description = 'Repas, courses, colis et bien plus, livrés à Marrakech.',
  services = siteData.services,
} = Astro.props;
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <span class="text-topper font-bold uppercase tracking-widest text-primary">
        {topper}
      </span>

      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
        {heading}
      </h2>

      <p class="mt-3 text-text-muted leading-relaxed">
        {description}
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {services.map((service) => (
        <li class="h-full">
          <div class="flex h-full flex-col rounded-lg border border-border bg-background p-6 shadow-sm transition-shadow duration-200 hover:shadow-md">
            <h3 class="font-heading text-h3 font-semibold text-text">
              {service.title}
            </h3>

            <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">
              {service.description}
            </p>

            <a
              href={service.href || 'https://wa.me/212674007161'}
              target="_blank"
              rel="noopener noreferrer"
              class="group mt-4 inline-flex w-fit items-center gap-1 text-sm font-semibold text-primary transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
            >
              {service.buttonText || 'Commander maintenant'}

              <span
                class="transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
