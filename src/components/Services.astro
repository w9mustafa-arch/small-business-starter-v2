---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteData } from '../data/siteData';

interface ServiceItem {
  key?: string;
  badge?: string;
  points?: string[];
  message?: string;
  title: string;
  description: string;
  href?: string;
  buttonText?: string;
}

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  services?: ServiceItem[];
}

const {
  topper = 'Nos services',
  heading = 'Nos services de livraison',
  description = 'Repas, courses, colis et bien plus, livrés à Marrakech.',
  services = siteData.services as unknown as ServiceItem[],
} = Astro.props;

// Photos des cartes : déposez une image dans src/assets/images/services/
// dont le nom correspond à la clé du service (ex. pharmacie.jpg, pressing.jpg).
const serviceImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/services/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const imageByKey: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(serviceImages)) {
  const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  imageByKey[name] = mod.default;
}

// Cadrage de chaque photo dans la carte (object-position).
const focus: Record<string, string> = {
  repas: '50% 68%',
  courses: '50% 45%',
  cadeaux: '50% 38%',
  coursier: '50% 50%',
};

// Icônes de secours pour les services sans photo.
const icons: Record<string, string> = {
  pharmacie: 'M9 3h6v6h6v6h-6v6H9v-6H3V9h6z',
  pressing:
    'M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z',
};

const waLink = (s: ServiceItem) => {
  const base = s.href || 'https://wa.me/212674007161';
  return s.message && !base.includes('?')
    ? `${base}?text=${encodeURIComponent(s.message)}`
    : base;
};
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <span class="text-topper font-bold uppercase tracking-widest text-primary">
        {topper}
      </span>

      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
        {heading}
      </h2>

      <p class="mt-3 text-text-muted leading-relaxed">
        {description}
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {services.map((service) => {
        const image = service.key ? imageByKey[service.key] : undefined;
        const icon = service.key ? icons[service.key] : undefined;
        return (
          <li class="h-full">
            <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-background shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl motion-reduce:transition-none motion-reduce:hover:translate-y-0">
              <div class="relative aspect-[4/3] overflow-hidden bg-linear-to-br from-primary to-dark">
                {image && (
                  <Image
                    src={image}
                    alt=""
                    aria-hidden="true"
                    widths={[480, 720, 960]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    loading="lazy"
                    style={`object-position: ${focus[service.key!] ?? '50% 50%'}`}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                )}

                {!image && icon && (
                  <div class="flex h-full w-full items-center justify-center text-white/90" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      class="size-20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <path d={icon} />
                    </svg>
                  </div>
                )}

                <div
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-dark/40 to-transparent"
                  aria-hidden="true"
                />

                {service.badge && (
                  <span class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-white/95 px-3 py-1 text-xs font-bold uppercase tracking-wide text-dark shadow-sm">
                    <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
                    {service.badge}
                  </span>
                )}
              </div>

              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-heading text-h3 font-semibold text-text">
                  {service.title}
                </h3>

                <p class="mt-2 text-sm leading-relaxed text-text-muted">
                  {service.description}
                </p>

                {service.points && service.points.length > 0 && (
                  <ul class="mt-4 space-y-2 border-t border-border pt-4" role="list">
                    {service.points.map((point) => (
                      <li class="flex items-start gap-2 text-sm text-text">
                        <svg
                          viewBox="0 0 24 24"
                          class="mt-0.5 size-4 shrink-0 text-accent"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <a
                  href={waLink(service)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-bold text-primary-fg transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
                  </svg>
                  {service.buttonText || 'Commander maintenant'}
                </a>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  </div>
</section>
