---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteData } from '../data/siteData';

const whatsappHref = `https://wa.me/${siteData.phoneForTel.replace('+', '')}`;
---

<BaseLayout
  title="Page introuvable"
  description="Cette page n’existe pas ou a été déplacée."
>
  <Header slot="header" />

  <section class="flex min-h-[60vh] items-center py-section">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
      <p class="font-heading text-display font-bold text-primary">404</p>
      <h1 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
        Page introuvable
      </h1>
      <p class="mx-auto mt-4 max-w-md leading-relaxed text-text-muted">
        Cette page n’existe pas ou a été déplacée. Vérifiez l’adresse ou retournez à l’accueil.
      </p>

      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href="/"
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-8 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Retour à l’accueil
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Commander sur WhatsApp
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
