---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import faqData from '../data/faqData.json';
import { aboutImage } from '../config/images';

const reasons = [
  {
    title: '24h/24, 7j/7',
    text: 'Écrivez-nous à toute heure, de jour comme de nuit.',
  },
  {
    title: 'Commande par WhatsApp',
    text: 'Un message suffit. Pas d’application à installer.',
  },
  {
    title: 'Une équipe de 5 livreurs',
    text: 'Des livreurs qui connaissent bien Marrakech et ses ruelles.',
  },
  {
    title: 'Riads, hôtels et villas',
    text: 'Livraison directement chez vous, où que vous logiez.',
  },
];

const zones = [
  'Guéliz',
  'Médina',
  'Hivernage',
  'Palmeraie',
  'Agdal',
  'Targa',
  'Route de l’Ourika',
  'Sidi Youssef Ben Ali',
];

// 6 questions clés tirées de src/data/faqData.json  →  [slug du sujet, numéro de la question]
// Pour en changer : modifiez cette liste (les réponses restent synchronisées avec la page FAQ).
const picks: [string, number][] = [
  ['commande-paiement', 0], // Comment passer une commande
  ['commande-paiement', 2], // Paiement
  ['nuit', 0],              // Livraison de nuit
  ['riad', 0],              // Riads
  ['hotel', 0],             // Hôtels
  ['pharmacie', 0],         // Pharmacie
];

type FaqGroup = { title: string; slug: string; items: string[][] };
const faqs = picks.map(([slug, i]) => {
  const [q, a] = (faqData as FaqGroup[]).find((g) => g.slug === slug)!.items[i];
  return { q: q.trim(), a: a.trim() };
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="Qui sommes-nous ? Livreur à Marrakech"
  description="Livraison Plus : une équipe de 5 livreurs à Marrakech depuis 5 ans. Repas, courses, pharmacie et colis livrés 24h/24, 7j/7."
  schema={faqSchema}
>
  <Header slot="header" />

  <Banner title="Qui sommes-nous ?" />

  <!-- Histoire -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src={aboutImage}
          alt="Équipe de livreurs Livraison Plus à Marrakech"
          width={800}
          height={600}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-primary">Notre histoire</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Livreur à Marrakech depuis 5 ans</h2>
        <p class="text-text-muted leading-relaxed">
          Livraison Plus est née à Marrakech d’un besoin simple : se faire livrer vite, sans complications.
        </p>
        <p class="text-text-muted leading-relaxed">
          Aujourd’hui, nous sommes une équipe de 5 livreurs. Vous nous écrivez sur WhatsApp, nous récupérons votre commande et la livrons où vous voulez, de jour comme de nuit.
        </p>
      </div>
    </div>
  </section>

  <!-- Pourquoi nous -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-primary">Pourquoi nous choisir</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Simple, rapide, fiable</h2>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map(({ title, text }) => (
          <div class="rounded-lg bg-background p-6 shadow-sm">
            <h3 class="font-heading text-lg font-semibold text-text">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Zones -->
  <section class="py-section">
    <div class="mx-auto max-w-site px-4 text-center sm:px-6">
      <span class="text-topper font-bold uppercase tracking-widest text-primary">Zones de service</span>
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Livraison dans tout Marrakech</h2>
      <p class="mx-auto mt-3 max-w-xl text-text-muted leading-relaxed">
        Nous livrons dans la plupart des quartiers de la ville.
      </p>

      <ul class="mt-8 flex flex-wrap justify-center gap-3" role="list">
        {zones.map((zone) => (
          <li class="rounded-full border border-border bg-surface px-5 py-2 text-sm font-medium text-text">
            {zone}
          </li>
        ))}
      </ul>

      <p class="mt-6 text-sm text-text-muted">
        Votre quartier n’est pas dans la liste ? Écrivez-nous, nous vérifions la disponibilité.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="mb-10 text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-primary">FAQ</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Questions fréquentes</h2>
      </div>

      <div class="flex flex-col gap-3">
        {faqs.map(({ q, a }) => (
          <details class="group rounded-lg border border-border bg-background shadow-sm transition-colors open:border-primary/40">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-lg px-5 py-4 text-base font-semibold text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:text-lg [&::-webkit-details-marker]:hidden">
              <span>{q}</span>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
              </span>
            </summary>
            <div class="border-t border-border px-5 pb-5 pt-4 leading-relaxed text-text-muted">{a}</div>
          </details>
        ))}
      </div>

      <p class="mt-8 text-center">
        <a href="/faq" class="font-semibold text-primary hover:underline">Voir toutes les questions</a>
      </p>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
