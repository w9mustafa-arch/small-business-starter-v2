---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';

const { services } = siteData;
---

<BaseLayout
  title="Livraison Marrakech : repas, courses, colis"
  description="Livreur Marrakech : repas, courses, pharmacie, pressing, fleurs et colis livrés 24h/24 à domicile, au riad ou à l’hôtel. Commandez sur WhatsApp."
>
  <Header slot="header" />

  <Banner title="Livraison Marrakech : nos services" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Votre livreur à Marrakech pour tous vos besoins</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Repas, courses, pharmacie, pressing, fleurs et colis : décrivez votre demande sur WhatsApp, votre livreur à Marrakech s’en occupe.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {services.map((service) => (
          <div class="flex gap-5 rounded-lg border border-border bg-background p-6 shadow-sm">
            <div>
              <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
              <p class="mt-2 text-text-muted leading-relaxed">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
