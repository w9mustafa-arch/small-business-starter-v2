---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Reviews from '../components/Reviews.astro';
import Gallery from '../components/Gallery.astro';
import CTA from '../components/CTA.astro';
import { siteData } from '../data/siteData';

const metaDescription =
  'Un message WhatsApp, et votre livreur à Marrakech récupère repas, courses, pharmacie ou colis et les livre chez vous, au riad ou à l’hôtel. 24h/24, 7j/7.';
---

<BaseLayout
  title="Livreur Marrakech 24h/24 : repas, courses, colis"
  description={metaDescription}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: siteData.name,
    description: metaDescription,
    telephone: siteData.phoneForTel,
    email: siteData.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteData.address.lineOne,
      addressLocality: siteData.address.city,
      addressRegion: siteData.address.state,
      postalCode: siteData.address.zip,
      addressCountry: siteData.address.country,
    },
    areaServed: { '@type': 'City', name: 'Marrakech' },
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
    url: siteData.url,
  }}
>
  <Header slot="header" />

  <Hero
    topper="Livreur à Marrakech · 24h/24 · 7j/7"
    heading="Votre livreur à Marrakech : un message, et c’est livré"
    description="Restaurant, supermarché, pharmacie, pressing ou fleuriste : dites-nous ce qu’il vous faut et où vous êtes. Nous récupérons, nous livrons, à domicile, au riad, à l’hôtel ou à la villa."
    secondaryLabel="Voir ce que nous livrons"
    imageAlt="Livreur à moto avec un sac isotherme bleu, livraison à Marrakech en soirée"
  />
  <TrustBar title="Vos enseignes préférées, livrées chez vous" />
  <Services
    topper="Ce que nous livrons"
    heading="Livraison Marrakech : du repas du soir au cadeau de dernière minute"
    description="Vous nous dites quoi, où et quand. Nous nous chargeons du reste."
  />
  <About
    topper="Qui sommes-nous"
    heading="Un livreur à Marrakech sur qui compter"
    body={[
      'Livreur Express est né d’un besoin simple : se faire livrer vite, sans application à installer ni compte à créer.',
      'Notre équipe connaît les quartiers de Marrakech et les ruelles de la médina. Vous écrivez sur WhatsApp, nous confirmons, nous livrons.',
    ]}
    benefits={[
      'Réponse sur WhatsApp, à toute heure',
      'Livraison à domicile, au bureau, au riad ou à l’hôtel',
      'Des livreurs qui connaissent la médina',
    ]}
    ctaLabel="Découvrir nos services"
    imageAlt="Livreur Express remet une commande à une cliente à Marrakech"
  />
  <Reviews
    topper="Avis clients"
    heading="Ponctuel, réactif, sérieux : l’avis de nos clients"
  />
  <Gallery
    topper="En images"
    heading="Livraison Marrakech : vos commandes en route"
    description="Repas, courses, fleurs et cadeaux : un aperçu de ce que nous livrons au quotidien à Marrakech."
  />
  <CTA
    title="Besoin d’un livreur à Marrakech ?"
    description="Décrivez votre demande sur WhatsApp et partagez votre position. Nous vous répondons à toute heure."
  />

  <Footer slot="footer" />
</BaseLayout>
