---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import LegalPage from '../components/LegalPage.astro';
import { termsOfService } from '../data/terms';

const title = 'Conditions générales';

const description =
  'Consultez les conditions générales d’utilisation du site Livraison Plus et les règles applicables aux services de livraison et de courses à Marrakech.';
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <Banner title={title} />

  <LegalPage
    effectiveDate={termsOfService.effectiveDate}
    sections={termsOfService.sections}
  />

  <Footer slot="footer" />
</BaseLayout>
