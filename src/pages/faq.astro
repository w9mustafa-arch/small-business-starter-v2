---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import { siteData } from '../data/siteData';
import faqData from '../data/faqData.json';

type FaqGroup = { title: string; slug: string; items: string[][] };
const groups = faqData as FaqGroup[];

const totalQuestions = groups.reduce((sum, g) => sum + g.items.length, 0);

const icons: Record<string, string> = {
  riad: '🏺',
  hotel: '🏨',
  villa: '🏡',
  touristes: '🧳',
  pharmacie: '💊',
  courses: '🛒',
  repas: '🍽️',
  golf: '⛳',
  nuit: '🌙',
  'fleurs-cadeaux': '💐',
  pressing: '👔',
  'commande-paiement': '💳',
};

const whatsappHref = `https://wa.me/${siteData.phoneForTel.replace('+', '')}`;

// FAQPage structured data (helps Google show Q&A in search results)
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((g) =>
    g.items.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  ),
};
---

<BaseLayout
  title="Questions fréquentes"
  description="Toutes les réponses à vos questions sur Livraison Plus à Marrakech : riads, hôtels, villas, pharmacie, courses, repas, livraison de nuit, paiement et commande par WhatsApp."
  schema={schema}
>
  <Header slot="header" />

  <Banner title="Questions fréquentes" />

  <!-- ── Intro + search + topics ───────────────────────────────────────── -->
  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">
          Comment pouvons-nous vous aider ?
        </h2>
        <p class="mt-3 leading-relaxed text-text-muted">
          {totalQuestions} réponses sur la livraison à Marrakech. Cherchez un mot-clé ou choisissez un sujet ci-dessous.
        </p>

        <!-- Search -->
        <div class="relative mt-8">
          <svg
            class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-text-muted"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
          </svg>
          <input
            id="faq-search"
            type="search"
            autocomplete="off"
            placeholder="Rechercher : pharmacie, paiement, riad, nuit…"
            aria-label="Rechercher dans les questions fréquentes"
            class="min-h-14 w-full rounded-lg border border-border bg-background py-3 pl-12 pr-4 text-text shadow-sm transition-colors placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
        </div>
        <p id="faq-status" class="mt-3 min-h-5 text-sm text-text-muted" aria-live="polite"></p>
      </div>

      <!-- Topic cards -->
      <nav aria-label="Sujets" class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
        {groups.map((group) => (
          <a
            href={`#${group.slug}`}
            class="group flex flex-col items-start gap-3 rounded-lg border border-border bg-background p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:p-5"
          >
            <span class="flex size-11 items-center justify-center rounded-md bg-primary/10 text-2xl" aria-hidden="true">
              {icons[group.slug] ?? '❓'}
            </span>
            <span class="text-sm font-semibold leading-snug text-text sm:text-base">{group.title}</span>
            <span class="text-xs text-text-muted">{group.items.length} questions</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ── Questions ─────────────────────────────────────────────────────── -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-4xl space-y-14 px-4 sm:px-6">
      {groups.map((group) => (
        <div id={group.slug} class="scroll-mt-28" data-faq-group>
          <div class="mb-5 flex items-center gap-4">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-md bg-primary text-2xl" aria-hidden="true">
              {icons[group.slug] ?? '❓'}
            </span>
            <h2 class="font-heading text-h3 font-bold uppercase text-text">{group.title}</h2>
          </div>

          <div class="space-y-3">
            {group.items.map(([question, answer]) => (
              <details
                class="group rounded-lg border border-border bg-background shadow-sm transition-colors open:border-primary/40"
                data-faq-item
              >
                <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-lg px-5 py-4 text-base font-semibold text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:text-lg [&::-webkit-details-marker]:hidden">
                  <span>{question}</span>
                  <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="border-t border-border px-5 pb-5 pt-4 leading-relaxed text-text-muted">
                  {answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <!-- No results -->
      <div id="faq-empty" hidden class="rounded-lg border border-dashed border-border bg-background p-8 text-center">
        <p class="font-heading text-h3 font-bold uppercase text-text">Aucun résultat</p>
        <p class="mt-2 text-text-muted">
          Essayez un autre mot-clé ou posez-nous directement votre question sur WhatsApp.
        </p>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90"
        >
          Écrire sur WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-primary py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-site px-4 text-center sm:px-6">
      <h2 class="font-heading text-h2 font-bold uppercase text-primary-fg">
        Une autre question ?
      </h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-primary-fg/80">
        Vous n’avez pas trouvé votre réponse ? Écrivez-nous sur WhatsApp, nous vous répondons rapidement.
      </p>

      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Commander sur WhatsApp
        </a>
        <a
          href={`tel:${siteData.phoneForTel}`}
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border-2 border-primary-fg/30 px-8 py-3 text-base font-bold text-primary-fg transition-colors hover:border-primary-fg hover:bg-primary-fg/10"
        >
          Appeler {siteData.phoneFormatted}
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Client-side search: accent-insensitive, opens matching answers,
  // hides empty topics. Re-initialised on every page load (view transitions).
  const normalize = (s: string) =>
    s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

  function initFaqSearch() {
    const input = document.getElementById('faq-search') as HTMLInputElement | null;
    if (!input) return;

    const status = document.getElementById('faq-status')!;
    const empty = document.getElementById('faq-empty')!;
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-group]'));

    const run = () => {
      const q = normalize(input.value);
      let matches = 0;

      groups.forEach((group) => {
        let groupMatches = 0;
        group.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach((item) => {
          const hit = q === '' || normalize(item.textContent ?? '').includes(q);
          item.hidden = !hit;
          item.open = q !== '' && hit;
          if (hit) groupMatches++;
        });
        group.hidden = groupMatches === 0;
        matches += groupMatches;
      });

      empty.hidden = !(q !== '' && matches === 0);
      status.textContent =
        q === ''
          ? ''
          : matches === 0
            ? ''
            : `${matches} résultat${matches > 1 ? 's' : ''} trouvé${matches > 1 ? 's' : ''}`;
    };

    input.addEventListener('input', run);
    run();
  }

  document.addEventListener('astro:page-load', initFaqSearch);
</script>
